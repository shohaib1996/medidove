NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SITE_URL=https://your-domain.example

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=500

ELEVENLABS_API_KEY=your-elevenlabs-api-key
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id
ELEVENLABS_WEBHOOK_TOKEN=use-a-long-random-secret-for-elevenlabs-webhook-url

AUTOMATION_RUN_SECRET=use-a-long-random-secret-for-cron
OUTBOX_DISPATCH_SECRET=use-a-long-random-secret-for-delivery-cron
TASK_GENERATION_SECRET=use-a-long-random-secret-for-task-cron

# Optional Twilio fallback, disabled by default.
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM_PHONE=+15550100000
# TWILIO_WHATSAPP_FROM=whatsapp:+15550100000

# Set to meta_whatsapp after Meta approves the WhatsApp app.
OUTBOUND_MESSAGING_PROVIDER=disabled
META_WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-cloud-api-access-token
META_WHATSAPP_PHONE_NUMBER_ID=your-meta-whatsapp-phone-number-id
META_WHATSAPP_VERIFY_TOKEN=use-a-long-random-secret-for-meta-webhook-verification
META_WHATSAPP_GRAPH_VERSION=v23.0
# MESSAGE_DELIVERY_WEBHOOK_URL=https://your-messaging-provider-webhook.example/send

OUTBOUND_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-app-password
SMTP_FROM_EMAIL="MediDove Clinic <your-email@example.com>"

# Optional email webhook fallback.
# EMAIL_DELIVERY_WEBHOOK_URL=https://your-email-provider-webhook.example/send
# ELEVENLABS_OUTBOUND_CALL_WEBHOOK_URL=https://your-voice-provider-webhook.example/call
